# Generate API_TOKEN with scripts/bootstrap.py. Preserve this file without secrets.
API_TOKEN=replace_with_generated_token
TAVILY_API_KEY=
DEFAULT_SEARCH_QUERY=software engineer jobs India
SEARCH_RESULTS_PER_QUERY=10
MAX_SEARCH_REQUESTS_PER_DAY=10
ENRICH_WEB_RESULTS=true

# PostgreSQL is required for persistent/deployed data. Local example:
#   createdb applyr
#   JOBS_DATABASE_URL=postgresql+psycopg://localhost/applyr
# On Render, paste the Internal Database URL from your Render PostgreSQL service.
# postgres:// and postgresql:// URLs are normalized to the installed psycopg driver.
JOBS_DATABASE_URL=postgresql+psycopg://localhost/applyr
