# Run scripts/bootstrap.py to generate a private local .env.
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
API_TOKEN=replace_with_a_generated_secret
DATABASE_URL=sqlite:///../../storage/jobpilot.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LLM_PROVIDER=gemini
APPLICATION_MODE=approval
AUTO_SUBMIT_ENABLED=false
DISCOVERY_INTERVAL_HOURS=6

# Gemini is optional. Use a model ID available to your account.
GEMINI_API_KEY=
LLM_MODEL=
AI_MAX_JOBS_PER_RUN=5
DISCOVERY_EXECUTOR=local
DISCOVERY_SCHEDULE_ENABLED=false
# STORAGE_DIR defaults to the repository's private storage directory.
